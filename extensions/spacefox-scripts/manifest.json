{
  "manifest_version": 3,
  "name": "SpaceFox Scripts",
  "version": "1.0",
  "description": "SpaceFox's own first-party in-page behavior (CRT overlay, etc.)",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["generated/crt-overlay.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["spacefox-bridge.js", "osk-bridge.js", "spatial-nav.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "scripts@spacefox.local"
    }
  }
}
